datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ۱. انوم‌های لایه محاسباتی و مدل‌های ۲۰۲۶
// ==========================================

enum UserRole {
  ADMIN
  USER
}

enum SubscriptionTier {
  FREE
  PRO
  ULTRA
  MAX
}

enum AIModelType {
  GEMINI_35_FLASH
  GEMINI_31_PRO
  CLAUDE_FABLE_5
  GPT_OSS_120B
}

// ==========================================
// ۲. زیرساخت احراز هویت استاندارد (Next-Auth)
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// ۳. توسعه مدل کاربر با تلفیق اشتراکات متری
// ==========================================

model User {
  id                    String            @id @default(cuid())
  name                  String?
  email                 String?           @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  role                  UserRole          @default(USER)
  accounts              Account[]
  sessions              Session[]

  // لایه مالی و اشتراک استرایپ (حفظ هماهنگی با وب‌هوک‌ها)
  stripeCustomerId       String?           @unique
  stripeSubscriptionId   String?           @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  decayBypassed          Boolean           @default(false)
  dailyUsageCount        Int               @default(0)
  lastRequestTimestamp   DateTime          @default(now())

  // لایه توکن‌نویسی و اعتبارات پلتفرم OMNI
  tier                  SubscriptionTier  @default(FREE)
  credits               Decimal           @default(10000.0000) @db.Decimal(18, 4)
  usages                Usage[]
  usageLogs             UsageLog[]

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

// ==========================================
// ۴. لایه ممیزی تراکنش‌ها و مصرف توکن هوش مصنوعی
// ==========================================

model Usage {
  id               String   @id @default(cuid())
  userId           String
  platform         String   // OMNI_CHANNEL, TWITTER, LINKEDIN
  promptTokens     Int      // توکن‌های ورودی فشرده‌شده
  completionTokens Int      // توکن‌های خروجی تولید شده
  costUsd          Float    // هزینه واقعی تراکنش برای شما
  modelUsed        String   // نام مدل پردازش‌کننده نهایی
  parallelChannels String[]
  qualityCoefficient Float  @default(1.0)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageLog {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputTokens     Int
  outputTokens    Int
  creditsDeducted Float
  modelUsed       AIModelType
  promptHash      String
  createdAt       DateTime    @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ==========================================
// ۵. لایه حافظه معنایی پنهان برای قانون هزینه صفر
// ==========================================

model SemanticCache {
  id         String      @id @default(uuid())
  inputHash  String      @unique
  inputText  String      @db.Text
  outputText Json
  modelUsed  AIModelType
  createdAt  DateTime    @default(now())

  @@index([inputHash])
}
