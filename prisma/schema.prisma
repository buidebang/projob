datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ۱. انوم‌های لایه محاسباتی و مدل‌های ۲۰۲۶
// ==========================================

enum UserRole {
  ADMIN
  USER
}

enum SubscriptionTier {
  FREE
  PRO
  ULTRA
  MAX
}

enum AIModelType {
  GEMINI_35_FLASH
  GEMINI_31_PRO
  CLAUDE_FABLE_5
  GPT_OSS_120B
}

// ==========================================
// ۲. زیرساخت احراز هویت استاندارد (Next-Auth)
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// ۳. توسعه مدل کاربر با تلفیق اشتراکات متری
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  accounts      Account[]
  sessions      Session[]

  // لایه مالی و اشتراک استرایپ (حفظ هماهنگی با وب‌هوک‌ها)
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  decayBypassed        Boolean   @default(false)
  decayBypassExpiresAt DateTime?
  dailyUsageCount      Int       @default(0)
  lastRequestTimestamp DateTime  @default(now())
  tierUpgradedAt       DateTime  @default(now())
  capacityMultiplier   Int       @default(1)

  // لایه مانیتورینگ چرخه
  current_cycle_start        DateTime?
  tokens_consumed_this_cycle Int       @default(0)
  is_throttled               Boolean   @default(false)

  // لایه توکن‌نویسی و اعتبارات پلتفرم OMNI
  tier           SubscriptionTier @default(FREE)
  credits        Decimal          @default(10000.0000) @db.Decimal(18, 4)
  usages         Usage[]
  usageLogs      UsageLog[]
  generations    Generation[]
  scheduledPosts ScheduledPost[]
  agentJobs      AgentJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// ۴. لایه ممیزی تراکنش‌ها و مصرف توکن هوش مصنوعی
// ==========================================

model Usage {
  id               String   @id @default(cuid())
  userId           String
  platform         String // OMNI_CHANNEL, TWITTER, LINKEDIN
  promptTokens     Int // توکن‌های ورودی فشرده‌شده
  completionTokens Int // توکن‌های خروجی تولید شده
  costUsd          Float // هزینه واقعی تراکنش برای شما
  modelUsed        String // نام مدل پردازش‌کننده نهایی
  parallelChannels String[]
  qualityApplied   Float    @default(1.0)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageLog {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputTokens     Int
  outputTokens    Int
  creditsDeducted Float
  modelUsed       AIModelType
  promptHash      String
  createdAt       DateTime    @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ==========================================
// ۵. لایه حافظه معنایی پنهان برای قانون هزینه صفر
// ==========================================

model SemanticCache {
  id         String      @id @default(uuid())
  inputHash  String      @unique
  inputText  String      @db.Text
  outputText Json
  modelUsed  AIModelType
  createdAt  DateTime    @default(now())

  @@index([inputHash])
}

model PlatformPolicy {
  id String @id @default("CURRENT_GLOBAL_POLICY")

  // Free / Anonymous Parameters
  freeBoostDurationDays  Int   @default(1)
  freeMaxParallelOutputs Int   @default(1)
  freeDecayCoefficient   Float @default(0.25)

  // Pro Subscription Parameters
  proBoostDurationDays  Int   @default(3)
  proMaxParallelOutputs Int   @default(2)
  proDecayCoefficient   Float @default(0.15)

  // Max Subscription Parameters
  maxBoostDurationDays  Int   @default(7)
  maxMaxParallelOutputs Int   @default(8)
  maxDecayCoefficient   Float @default(0.05)

  updatedAt DateTime @updatedAt
}

// ==========================================
// 6. نسل‌های ذخیره‌شده (History)
// ==========================================
model Generation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  inputText String   @db.Text
  platform  String
  model     String
  output    String   @db.Text

  @@index([userId])
}

// ==========================================
// 7. SystemConfig
// ==========================================
model SystemConfig {
  id                              String   @id @default("CURRENT_GLOBAL_CONFIG")
  api_cost_per_million_tokens     Float    @default(0.15)
  tier_guest_profit_margin        Int      @default(0)
  tier_basic_profit_margin        Int      @default(0)
  tier_pro_profit_margin          Int      @default(70)
  tier_max_profit_margin          Int      @default(85)
  multiplier_upsell_price         Float    @default(5)
  multiplier_profit_margin        Int      @default(60)
  global_ai_generation_enabled    Boolean  @default(true)
  deep_search_enabled             Boolean  @default(true)
  quota_cycle_type                String   @default("WEEKLY")
  honeymoon_period_days           Int      @default(3)
  active_ai_provider              String   @default("OPENROUTER")
  direct_api_key                  String?
  direct_model_name               String?
  openrouter_api_key              String?
  openrouter_model_name           String?
  ai_base_url                     String?
  ai_auth_header_type             String   @default("Bearer")
  ai_target_model_id              String?
  deep_search_allowed_tiers       String[] @default(["PRO", "ULTRA", "MAX"])
  guest_max_tokens                Int      @default(1000)
  guest_upload_limit              Int      @default(0)
  free_max_tokens                 Int      @default(5000)
  free_upload_limit               Int      @default(2)
  pro_price                       Float    @default(5.0)
  pro_max_tokens                  Int      @default(50000)
  pro_upload_limit                Int      @default(10)
  ultra_price                     Float    @default(20.0)
  ultra_max_tokens                Int      @default(200000)
  ultra_upload_limit              Int      @default(50)
  max_price                       Float    @default(70.0)
  max_max_tokens                  Int      @default(1000000)
  max_upload_limit                Int      @default(200)
  throttle_degradation_percentage Float    @default(0.5)



  soft_throttle_reduction_percent Int      @default(80)

  cost_light_model                Int      @default(2)
  cost_medium_model               Int      @default(5)
  cost_heavy_model                Int      @default(20)
  cost_deep_search                Int      @default(5)
  active_auth_providers           String[] @default(["google", "github", "email"])

  isEmergencyMode                 Boolean  @default(false)
  fallbackModelName               String   @default("gemini-1.5-flash")
  fallbackApiKeys                 String[] @default([])

  updatedAt DateTime @updatedAt
}

// ==========================================
// 8. AIModelRegistry
// ==========================================
model AIModelRegistry {
  id                      String   @id @default(cuid())
  provider                String // 'DIRECT_GEMINI' or 'OPENROUTER'
  model_name              String   @unique
  api_key                 String?
  base_url                String?
  constraints             String?
  cost_per_million_input  Float
  cost_per_million_output Float
  is_active               Boolean  @default(false)
  is_fallback_model       Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ==========================================
// 9. Knowledge Base (RAG)
// ==========================================
model KnowledgeBase {
  id         String   @id @default(cuid())
  platform   String   @unique
  rules_text String   @db.Text
  embedding  Float[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum PostStatus {
  PENDING
  PUBLISHING
  SUCCESS
  FAILED
  BACKOFF
  PENDING_APPROVAL
}

enum TelemetryPhase {
  PRE_FLIGHT
  NETWORK
  POST_FLIGHT
}

model ScheduledPost {
  id                    String         @id @default(cuid())
  userId                String
  platform              String
  content               String         @db.Text
  scheduledFor          DateTime
  status                PostStatus     @default(PENDING)
  authorizationRequired Boolean        @default(false)
  authorizationToken    String?        @db.Text
  telemetry             TelemetryLog[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scheduledFor])
  @@index([status])
}

model TelemetryLog {
  id        String         @id @default(cuid())
  postId    String
  timestamp DateTime       @default(now())
  phase     TelemetryPhase
  metrics   Json
  post      ScheduledPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model AgentJob {
  id          String    @id @default(cuid())
  userId      String
  jobType     String
  status      JobStatus @default(QUEUED)
  payload     Json?
  result      Json?
  progress    Float     @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
